# ==============================================================================
# A-Store Environment Variables
# Copy to .env.local: cp .env.example .env.local
# ==============================================================================

# Supabase Public API (Accessible by client & browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production & SEO Site URL (e.g. http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-Side Only / Service Role (NEVER prefix with NEXT_PUBLIC)
# Required for admin operations (customer management, storage uploads, audit log)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin demo sign-in password (server-side only, protects demo admin access)
ADMIN_DEMO_PASSWORD=your-secure-admin-password

# Optional: comma-separated list of additional seller emails authorized to manage orders
SELLER_EMAILS=tester@a-store.shop
